<odoo>

    <record id="view_proveedores_list" model="ir.ui.view">
        <field name="name">relojeria.proveedores.list</field>
        <field name="model">relojeria.proveedores</field>
        <field name="arch" type="xml">
            <list string="Proveedores">
                <field name="nombre_proveedor"/>
                <field name="precio_compra"/>
                <field name="telefono"/>
                <field name="direccion"/>
            </list>
        </field>
    </record>

    <record id="view_proveedores_form" model="ir.ui.view">
        <field name="name">relojeria.proveedores.form</field>
        <field name="model">relojeria.proveedores</field>
        <field name="arch" type="xml">
            <form string="Ficha del Proveedor">
                <sheet>
                    <group>
                        <field name="nombre_proveedor"/>
                        <field name="precio_compra"/>
                        <field name="telefono"/>
                        <field name="direccion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_proveedores" model="ir.actions.act_window">
        <field name="name">Proveedores</field>
        <field name="res_model">relojeria.proveedores</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_proveedores"
              parent="menu_relojeria_root"
              name="Proveedores"
              action="action_proveedores"
              sequence="20"/>

</odoo>
