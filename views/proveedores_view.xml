<odoo>

    <!-- Vista LIST -->
    <record id="view_proveedores_list" model="ir.ui.view">
        <field name="name">relojeria.proveedores.list</field>
        <field name="model">relojeria.proveedores</field>
        <field name="arch" type="xml">
            <list string="Proveedores">
                <field name="nombre_proveedor"/>
                <field name="precio_compra"/>
                <field name="telefono"/>
                <field name="direccion"/>
                <field name="metodo_pago"/>
                <field name="plazo_entrega"/>
                <field name="fecha_alta"/>
                <field name="ultima_entrega"/>
                <field name="total_relojes"/>
                <field name="activo"/>
            </list>
        </field>
    </record>

    <!-- Vista FORM -->
    <record id="view_proveedores_form" model="ir.ui.view">
        <field name="name">relojeria.proveedores.form</field>
        <field name="model">relojeria.proveedores</field>
        <field name="arch" type="xml">
            <form string="Ficha del Proveedor">
                <sheet>
                    <field name="foto_adjunta" widget="image" class="oe_avatar"/>

                    <group>
                        <group>
                            <field name="nombre_proveedor"/>
                            <field name="telefono"/>
                            <field name="direccion"/>
                            <field name="activo"/>
                        </group>
                        <group>
                            <field name="precio_compra"/>
                            <field name="metodo_pago"/>
                            <field name="plazo_entrega"/>
                            <field name="pedidos"/>
                            <field name="total_relojes"/>
                        </group>
                    </group>

                    <group>
                        <field name="fecha_alta"/>
                        <field name="ultima_entrega"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista SEARCH -->
    <record id="view_proveedores_search" model="ir.ui.view">
        <field name="name">relojeria.proveedores.search</field>
        <field name="model">relojeria.proveedores</field>
        <field name="arch" type="xml">
            <search string="Buscar proveedores">
                <field name="nombre_proveedor"/>
                <field name="direccion"/>
                <field name="metodo_pago"/>
                <field name="plazo_entrega"/>
                <field name="activo"/>
            </search>
        </field>
    </record>

    <!-- Accion -->
    <record id="action_proveedores" model="ir.actions.act_window">
        <field name="name">Proveedores</field>
        <field name="res_model">relojeria.proveedores</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_proveedores"
              parent="menu_relojeria_root"
              name="Proveedores"
              action="action_proveedores"
              sequence="20"/>

</odoo>