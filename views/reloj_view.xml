<odoo>

    <!-- Vista LIST -->
    <record id="view_reloj_list" model="ir.ui.view">
        <field name="name">relojeria.reloj.list</field>
        <field name="model">relojeria.reloj</field>
        <field name="arch" type="xml">
            <list string="Caracteristicas del Reloj">
                <field name="calidad"/>
                <field name="tamano"/>
                <field name="materiales"/>
                <field name="peso"/>
                <field name="tipo_Reloj"/>
                <field name="resistencia_Agua"/>
                <field name="resistencia_GolpesAranazos"/>
                <field name="durabilidad"/>
                <field name="personalizacion"/>
            </list>
        </field>
    </record>

    <!-- Vista FORM -->
    <record id="view_reloj_form" model="ir.ui.view">
        <field name="name">relojeria.reloj.form</field>
        <field name="model">relojeria.reloj</field>
        <field name="arch" type="xml">
            <form string="Ficha del Reloj">
                <sheet>
                    <group>
                        <field name="calidad"/>
                        <field name="tamano"/>
                        <field name="materiales"/>
                        <field name="peso"/>
                        <field name="tipo_Reloj"/>
                        <field name="resistencia_Agua"/>
                        <field name="resistencia_GolpesAranazos"/>
                        <field name="durabilidad"/>
                        <field name="personalizacion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción que enlaza ambas vistas -->
    <record id="action_reloj" model="ir.actions.act_window">
        <field name="name">RELOJERIA</field>
        <field name="res_model">relojeria.reloj</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_reloj_list"/>
    </record>

    <!-- Menús -->
    <menuitem id="menu_relojeria_root" name="Gestionar la relojeria"/>

    <menuitem id="menu_relojeria_modificar"
              parent="menu_relojeria_root"
              name="Relojes"
              action="action_reloj"/>

</odoo>